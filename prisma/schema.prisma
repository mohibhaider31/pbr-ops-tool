// Prisma schema for the PBR Ops Tool.
// This DB holds only the metadata Jira doesn't: priority order within
// PBR, assignments (one or many people), per-person read/done state,
// and threaded questions/comments. Jira remains the source of truth
// for the story content and status itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoryStage {
  BACKLOG      // pulled in, not yet assigned for review
  ASSIGNED     // handed to one or more reviewers
  IN_REVIEW    // at least one reviewer has marked done, not all
  PBR_DONE     // discussed in PBR session, Jira transitioned to Ready for Dev
}

model Story {
  id            String     @id @default(cuid())
  boardId       String     @default("") // scoped to a board (backfilled to RAE)
  jiraKey       String     @unique // e.g. RAE-1234
  priorityOrder Int        @default(0) // lower = higher priority, set by PO drag/reorder
  stage         StoryStage @default(BACKLOG)
  pbrDoneAt     DateTime?

  assignees Assignee[]
  comments  Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, priorityOrder]) // backlog list: scoped + ordered in one index
  @@index([boardId])
}

model Assignee {
  id         String   @id @default(cuid())
  storyId    String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name       String
  email      String
  // Atlassian account id - the stable identity. Email can change; accountId
  // cannot. Nullable so existing rows and manually-added (not-yet-registered)
  // reviewers keep working; matching falls back to email when this is null.
  accountId  String?
  markedDone Boolean  @default(false)
  markedDoneAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([storyId, email])
  @@index([accountId])
}

model Comment {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author    String
  text      String
  isQuestion Boolean @default(false)
  createdAt DateTime @default(now())

  // Had NO indexes despite being queried by storyId (drawer + question
  // counts) and by isQuestion+author (My Work "my open questions").
  @@index([storyId, createdAt])
  @@index([storyId, isQuestion])
  @@index([author, isQuestion])
}

// --- Pipeline tracker (Engine -> Middleware -> Frontend) ---
// Tool-side layer tracking: Jira has no per-layer concept, so we attach
// three lightweight status cells to a story on our side. Keyed by jiraKey
// directly (not a Story FK) because pipeline covers any non-Done Jira
// story, whether or not it's been pulled into the backlog board yet.

enum Layer {
  ENGINE
  MIDDLEWARE
  FRONTEND
}

enum LayerStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

model LayerTrack {
  id        String      @id @default(cuid())
  boardId   String       @default("") // scoped to a board (backfilled to RAE)
  jiraKey   String       // e.g. RAE-1234 (the story this layer belongs to)
  layer     Layer
  status    LayerStatus  @default(NOT_STARTED)
  owner     String?      // free text for now; real identity comes with AUTH
  sprint    String?      // optional sprint tag
  doneAt    DateTime?    // set when status flips to DONE (drives stall detection)
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  @@unique([boardId, jiraKey, layer])
  @@index([jiraKey])
}

// Pipeline membership. A story appears in the tracker only once explicitly
// added. Kept separate from LayerTrack so removing a story from the pipeline
// drops only its membership — the layer statuses persist, and re-adding
// resumes exactly where it left off.
model PipelineItem {
  id       String   @id @default(cuid())
  boardId  String   @default("") // scoped to a board (backfilled to RAE)
  jiraKey  String
  addedAt  DateTime @default(now())

  @@unique([boardId, jiraKey])
  @@index([boardId])
}

// Server-side auth sessions. The browser cookie holds only the small `id`;
// the actual Atlassian tokens and identity live here, keyed by that id. This
// keeps the cookie tiny (no multi-KB tokens in the browser) and lets us
// revoke/refresh server-side.
model AuthSession {
  id              String   @id @default(cuid())
  // Absolute server-side expiry. The cookie's Max-Age is only a client hint —
  // without this, a session id stayed valid on the server forever, which
  // matters most for local accounts (they have no token refresh that would
  // eventually fail).
  expiresAt       DateTime?
  accountId       String
  name            String
  email           String?
  avatarUrl       String?
  authType        String   @default("atlassian")
  // Null for local sessions - they hold no Atlassian credentials at all,
  // which is what makes them structurally incapable of acting in Jira.
  cloudId         String?
  accessToken     String?
  refreshToken    String?
  accessExpiresAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
}

// People. Identity + global admin flag. Product roles are now per-board via
// BoardMembership (a person can be PO on one board, Developer on another).
enum BoardRole {
  PO
  BA
  DEVELOPER
  VIEWER
}

model Person {
  id          String    @id @default(cuid())
  // For Atlassian users this is their real Atlassian account id. For local
  // (stakeholder) accounts it is a synthetic "local:<cuid>" value, so every
  // existing accountId-based lookup keeps working unchanged.
  accountId   String?   @unique
  email       String?   @unique
  name        String
  // "atlassian" = full participant, acts in Jira under their own OAuth token.
  // "local"     = read-only stakeholder. NO Atlassian token, and structurally
  //               barred from Jira-writing capabilities (see lib/guard.ts).
  authType    String    @default("atlassian")
  passwordHash String?  // local accounts only; bcrypt, cost 12
  avatarUrl   String?
  isAdmin     Boolean   @default(false) // global, tool-level admin
  source      String    @default("jira") // "jira" | "manual"
  firstLoginAt DateTime? // set on the person's first real login to the tool; null = invited but never used
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships BoardMembership[]
}

// A board maps 1:1 to a Jira project and carries its own workflow config.
// Everything operational (stories, pipeline, poker) is scoped to a board.
model Board {
  id                 String  @id @default(cuid())
  name               String
  jiraProjectKey     String  @unique // e.g. RAE
  backlogStatus      String  @default("To Do")
  readyForDevStatus  String  @default("Ready For Dev")
  pbrDonePath        String  @default("") // comma-separated transition chain to Ready For Dev
  isDefault          Boolean @default(false) // the board new users land on
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships BoardMembership[]
}

// A person's role on a specific board. Absence of a membership = no access to
// that board.
model BoardMembership {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  role      BoardRole @default(DEVELOPER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([personId, boardId])
  @@index([boardId])
}

// --- Planning Poker ---
// A session is a working meeting: the team joins once by invite code and
// walks through a QUEUE of stories together, one at a time. The organizer
// (PO) adds stories, advances the room to the current story, and everyone's
// screen follows. Each story (PokerItem) has its own voting rounds and, on
// accept, syncs its points to Jira. Realtime fan-out via Pusher.

enum PokerState {
  VOTING
  REVEALED
}

enum PokerItemStatus {
  PENDING
  DONE
}

model PokerSession {
  id            String    @id @default(cuid())
  boardId       String    @default("") // scoped to a board (backfilled to RAE)
  code          String    @unique
  organizerId   String    // accountId of the organizer
  organizerName String
  currentItemId String?   // the PokerItem currently on everyone's screen
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items PokerItem[]

  @@index([code])
}

model PokerItem {
  id          String          @id @default(cuid())
  sessionId   String
  session     PokerSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  jiraKey     String
  summary     String
  order       Int             @default(0)
  status      PokerItemStatus @default(PENDING)
  state       PokerState      @default(VOTING) // voting/revealed for THIS story
  round       Int             @default(1)
  finalPoints Int?
  alignmentScore Int? // 1-5 team alignment at accept time
  refinementPollOpen Boolean @default(false) // is the post-accept refinement poll active
  rediscussionScore Int? // 1-5 snapshot after the refinement poll closed
  investPollOpen Boolean @default(false) // is the INVEST scoring poll active
  investScore Float? // 0-6 average across participants, snapshot when closed
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  votes PokerVote[]
  refinementVotes RefinementVote[]
  investVotes InvestVote[]

  @@index([sessionId])
}

model PokerVote {
  id        String    @id @default(cuid())
  itemId    String
  item      PokerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  round     Int
  voterId   String
  voterName String
  card      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([itemId, round, voterId])
}

// Tracks Jira comment @-mentions the user has dismissed from their dashboard.
// A mention is identified by (accountId of viewer, jira comment id). Dismissing
// hides that specific comment; a NEW comment mentioning them re-appears because
// it has a different comment id.
model DismissedMention {
  id          String   @id @default(cuid())
  accountId   String   // the mentioned user who dismissed it
  jiraKey     String   // e.g. RAE-1234
  commentId   String   // Jira comment id
  dismissedAt DateTime @default(now())

  @@unique([accountId, commentId])
  @@index([accountId])
}

// Re-discussion tracking. A story accumulates a "needs refinement" flag each
// time a majority of a poker session votes that it still needs refinement,
// AFTER points were accepted. The score is derived: 5 minus flagCount, floored
// at 1. Keyed by board+jiraKey so it persists across separate poker sessions
// for the same story.
model StoryRefinement {
  id        String   @id @default(cuid())
  boardId   String
  jiraKey   String
  flagCount Int      @default(0) // number of sessions that flagged it for refinement
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([boardId, jiraKey])
  @@index([boardId])
}

// Per-session refinement poll: individual yes/no votes on "does this story
// still need refinement?" shown after points are accepted. Cleared logic lives
// on the PokerItem (one poll per item).
model RefinementVote {
  id         String    @id @default(cuid())
  itemId     String    // the PokerItem this poll belongs to
  item       PokerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  voterId    String
  voterName  String
  needsWork  Boolean   // true = "needs refinement"
  createdAt  DateTime  @default(now())

  @@unique([itemId, voterId])
  @@index([itemId])
}

// INVEST scoring. After the refinement poll, each participant scores the story
// on the 6 INVEST components (each 0 or 1). Their per-person total is 0-6. The
// story's INVEST score = average of all participants' totals, out of 6.
model InvestVote {
  id           String    @id @default(cuid())
  itemId       String
  item         PokerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  voterId      String
  voterName    String
  independent  Boolean   @default(false)
  negotiable   Boolean   @default(false)
  valuable     Boolean   @default(false)
  estimable    Boolean   @default(false)
  small        Boolean   @default(false)
  testable     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@unique([itemId, voterId])
  @@index([itemId])
}

// Local projection of Jira issues — the application's read model.
//
// Jira remains the system of record, but the UI must never wait on Atlassian
// to render a screen. Backlog, Pipeline, My Work, the poker story picker and
// the story drawer all read from here. A background sync keeps it fresh.
model JiraIssue {
  id                String    @id @default(cuid())
  boardId           String
  jiraKey           String
  summary           String
  status            String
  statusCategory    String?   // e.g. "Done" — lets us filter terminal states locally
  issueType         String?
  storyPoints       Float?
  assigneeAccountId String?
  assigneeName      String?
  labels            String[]  @default([])
  jiraUpdatedAt     DateTime?
  syncedAt          DateTime  @default(now())

  @@unique([boardId, jiraKey])
  @@index([boardId, status])
  @@index([assigneeAccountId])
}

// Tracks when each board's projection was last synced, so a read can decide
// whether to kick a background refresh.
model JiraSyncState {
  boardId    String    @id
  lastSyncAt DateTime?
  lastError  String?
  syncing    Boolean   @default(false)
  issueCount Int       @default(0)
  updatedAt  DateTime  @updatedAt
}

// Durable outbox for Jira writes.
//
// waitUntil() got Jira off the response path, but it isn't durable: if the
// call fails the local DB says "done" while Jira never received it, with no
// retry and no record. Writes are now enqueued in the same transaction as the
// local change and executed by a worker with backoff, so a transient Jira
// failure is retried instead of silently lost.
model OutboxJob {
  id            String    @id @default(cuid())
  boardId       String
  type          String    // SET_STORY_POINTS | ADD_COMMENT | TRANSITION_ISSUE
  jiraKey       String    // for display + per-story status in the UI
  payload       Json
  status        String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([boardId, jiraKey])
}


// Invite-only provisioning for local (stakeholder) accounts. There is no public
// signup: an admin creates an invite, the invitee sets a password once.
model LocalInvite {
  id         String    @id @default(cuid())
  email      String
  name       String
  tokenHash  String    @unique // sha256 of the emailed token; raw token never stored
  boardId    String?   // optional board to grant VIEWER on
  expiresAt  DateTime
  usedAt     DateTime?
  createdById String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Login throttling. Must be DB-backed: in-memory counters are per serverless
// instance and would be trivially bypassed.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// --- Roadmap ---
//
// Replaces Roadmunk. Two deliberate properties:
//
// 1. The roadmap is CURATED: an entry exists only because a PO published the
//    story to it at PBR time. Not every story belongs on a roadmap.
// 2. Dates and confirmed/tentative are OURS (human intent). Status and
//    completion come from the JiraIssue projection, so the roadmap can't drift
//    the way a hand-maintained one does — and viewing it needs no Jira call,
//    which is what lets stakeholders in without Jira licences.
model RoadmapEntry {
  id          String    @id @default(cuid())
  boardId     String
  jiraKey     String
  // Typed by hand: the team doesn't populate Jira's fixVersion, so this can't
  // be derived. Rendered as a badge rather than smuggled into the title.
  version     String?
  lane        String    @default("PRODUCT") // PRODUCT | HOUSEKEEPING | RESOURCE
  startDate   DateTime
  targetDate  DateTime
  // CONFIRMED renders blue, TENTATIVE grey — matching the existing convention.
  state       String    @default("CONFIRMED")
  order       Int       @default(0) // manual vertical ordering within a lane
  note        String?
  publishedBy String?
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([boardId, jiraKey])
  @@index([boardId, targetDate])
  @@index([boardId, lane])
}

// Standalone dated markers (UAT Release, Production Release, Regression).
// These aren't stories, so they're created directly on the roadmap.
model RoadmapMilestone {
  id        String   @id @default(cuid())
  boardId   String
  label     String
  date      DateTime
  kind      String   @default("RELEASE") // RELEASE | UAT | REGRESSION | OTHER
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, date])
}


// Self-service password reset for local accounts. Same shape as LocalInvite:
// only the token hash is stored, single use, short-lived.
model PasswordReset {
  id        String    @id @default(cuid())
  personId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([personId])
  @@index([expiresAt])
}
