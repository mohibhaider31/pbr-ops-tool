// Prisma schema for the PBR Ops Tool.
// This DB holds only the metadata Jira doesn't: priority order within
// PBR, assignments (one or many people), per-person read/done state,
// and threaded questions/comments. Jira remains the source of truth
// for the story content and status itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoryStage {
  BACKLOG      // pulled in, not yet assigned for review
  ASSIGNED     // handed to one or more reviewers
  IN_REVIEW    // at least one reviewer has marked done, not all
  PBR_DONE     // discussed in PBR session, Jira transitioned to Ready for Dev
}

model Story {
  id            String     @id @default(cuid())
  jiraKey       String     @unique // e.g. RAE-1234
  priorityOrder Int        @default(0) // lower = higher priority, set by PO drag/reorder
  stage         StoryStage @default(BACKLOG)
  pbrDoneAt     DateTime?

  assignees Assignee[]
  comments  Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([priorityOrder])
}

model Assignee {
  id         String   @id @default(cuid())
  storyId    String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name       String
  email      String
  markedDone Boolean  @default(false)
  markedDoneAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([storyId, email])
}

model Comment {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author    String
  text      String
  isQuestion Boolean @default(false)
  createdAt DateTime @default(now())
}

// --- Pipeline tracker (Engine -> Middleware -> Frontend) ---
// Tool-side layer tracking: Jira has no per-layer concept, so we attach
// three lightweight status cells to a story on our side. Keyed by jiraKey
// directly (not a Story FK) because pipeline covers any non-Done Jira
// story, whether or not it's been pulled into the backlog board yet.

enum Layer {
  ENGINE
  MIDDLEWARE
  FRONTEND
}

enum LayerStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

model LayerTrack {
  id        String      @id @default(cuid())
  jiraKey   String       // e.g. RAE-1234 (the story this layer belongs to)
  layer     Layer
  status    LayerStatus  @default(NOT_STARTED)
  owner     String?      // free text for now; real identity comes with AUTH
  sprint    String?      // optional sprint tag
  doneAt    DateTime?    // set when status flips to DONE (drives stall detection)
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  @@unique([jiraKey, layer])
  @@index([jiraKey])
}

// Pipeline membership. A story appears in the tracker only once explicitly
// added. Kept separate from LayerTrack so removing a story from the pipeline
// drops only its membership — the layer statuses persist, and re-adding
// resumes exactly where it left off.
model PipelineItem {
  id       String   @id @default(cuid())
  jiraKey  String   @unique
  addedAt  DateTime @default(now())
}

// Server-side auth sessions. The browser cookie holds only the small `id`;
// the actual Atlassian tokens and identity live here, keyed by that id. This
// keeps the cookie tiny (no multi-KB tokens in the browser) and lets us
// revoke/refresh server-side.
model AuthSession {
  id              String   @id @default(cuid())
  accountId       String
  name            String
  email           String?
  avatarUrl       String?
  cloudId         String
  accessToken     String
  refreshToken    String
  accessExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
}

// People and their roles. Roles are managed in-app (not from Jira, which has
// no PO/BA concept for this team). Two axes:
//  - isAdmin: global, tool-level (manage people/roles, admin dashboard later)
//  - role: per-board product role (single board for now; extends to
//    multi-board later by adding a board dimension)
// Source is "jira" (auto-detected from board members) or "manual" (added by
// email in Settings).
enum BoardRole {
  PO
  BA
  DEVELOPER
  VIEWER
}

model Person {
  id        String    @id @default(cuid())
  accountId String?   @unique // Atlassian account id; null until they first log in (manual adds)
  email     String?   @unique
  name      String
  avatarUrl String?
  role      BoardRole @default(DEVELOPER)
  isAdmin   Boolean   @default(false)
  source    String    @default("jira") // "jira" | "manual"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// --- Planning Poker ---
// A poker session estimates one story. Participants join by invite code,
// commit a card privately (hidden until reveal), the organizer reveals, and
// on accept the agreed points are written to Jira. Realtime fan-out (votes
// in, reveal, re-vote) is via Pusher on a channel keyed by the invite code.

enum PokerState {
  VOTING
  REVEALED
}

model PokerSession {
  id          String     @id @default(cuid())
  code        String     @unique // short invite code
  jiraKey     String     // story being estimated
  summary     String     // snapshot of the story summary at creation
  organizerId String     // Person.id or accountId of the organizer
  organizerName String
  state       PokerState @default(VOTING)
  round       Int        @default(1)
  finalPoints Int?       // set when accepted & synced to Jira
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  votes PokerVote[]

  @@index([code])
}

model PokerVote {
  id         String   @id @default(cuid())
  sessionId  String
  session    PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round      Int
  voterId    String   // accountId
  voterName  String
  card       String   // "1","2","3","5","8","13","21","?"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, round, voterId])
}
