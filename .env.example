# Postgres connection string. Easiest options: Vercel Postgres or Neon
# (both have free tiers and plug straight into Vercel env vars).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Jira Cloud
JIRA_BASE_URL="https://YOURSITE.atlassian.net"
JIRA_EMAIL="mohib@logicielservices.com"
JIRA_API_TOKEN="create-at-id.atlassian.com/manage-profile/security/api-tokens"
JIRA_PROJECT_KEY="RAE"

# Must exactly match the Jira status name your workflow transitions into
# after PBR. Defaults to "Ready for Dev" if unset.
JIRA_READY_FOR_DEV_STATUS="Ready for Dev"
